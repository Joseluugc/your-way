{
  "name": "app-eventos",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@supabase/supabase-js": "^2.119.0",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-haptics": "~58.0.8",
    "expo-linking": "~58.0.17",
    "expo-network": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "test:domain": "node --experimental-strip-types --test tests/*.test.mjs",
    "lint": "expo lint"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts?(x)",
      "<rootDir>/tests/**/*.test.mjs"
    ],
    "transform": {
      "\\.mjs$": [
        "babel-jest",
        {
          "presets": [
            "babel-preset-expo"
          ]
        }
      ]
    },
    "moduleNameMapper": {
      "^node:test$": "<rootDir>/__tests__/helpers/nodeTestShim.ts",
      "^node:assert/strict$": "<rootDir>/__tests__/helpers/nodeAssertShim.ts"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/app/**",
      "!**/*.d.ts"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 60
      },
      "./src/domain/": {
        "lines": 80
      }
    }
  }
}
